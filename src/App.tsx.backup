import { useState, useEffect } from 'react'

// ─── Types ────────────────────────────────────────────────────────────────────
type Screen =
  | 'splash'
  | 'role-select'
  | 'manager-auth'
  | 'manager-signup'
  | 'manager-login'
  | 'manager-home'
  | 'qr-share'
  | 'theme-customizer'
  | 'font-picker'
  | 'logo-upload'
  | 'estate-profile'
  | 'plan-select'
  | 'payment'
  | 'management'
  | 'tenant-code'
  | 'tenant-home'
  | 'tenant-bills'
  | 'maintenance'
  | 'emergency'
  | 'guest'
  | 'ai-chatbot'

interface EstateConfig {
  color: string
  fontFamily: string
  fontSize: number
  logoUrl: string
  bgImageUrl: string
  estateName: string
  joinCode: string
  subscription: 'basic' | 'premium' | 'platinum'
  logoPosition: 'top-left' | 'top-right' | 'center' | 'bottom-right'
  enable3D: boolean
  enableAI: boolean
  isGoldBlackTheme: boolean
  monthlyDues: number
  serviceChargePercent: number
}

interface Notification {
  id: string
  title: string
  message: string
  date: string
  type: 'announcement' | 'payment' | 'maintenance' | 'emergency'
  read: boolean
  verified?: boolean
}

interface PaymentRecord {
  id: string
  tenantName: string
  amount: number
  date: string
  status: 'pending' | 'verified' | 'rejected'
  type: 'estate_dues' | 'app_service'
  receiptUrl?: string
}

