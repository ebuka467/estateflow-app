// ─── Root App ─────────────────────────────────────────────────────────────────
export default function App() {
  const [screen, setScreen] = useState<Screen>('splash')
  const [config, setConfig] = useState<EstateConfig>(DEFAULT_CONFIG)
  const [menuOpen, setMenuOpen] = useState(false)

  const go = (s: Screen) => { setMenuOpen(false); setScreen(s) }

  const screens: Record<Screen, React.ReactNode> = {
    splash: <SplashScreen onDone={() => go('role-select')} />,
    'role-select': <RoleSelectScreen go={go} />,
    'manager-auth': <ManagerAuthScreen go={go} />,
    'manager-signup': <ManagerSignUpScreen go={go} />,
    'manager-login': <ManagerLoginScreen go={go} />,
    'manager-home': <ManagerHomeScreen go={go} config={config} menuOpen={menuOpen} setMenuOpen={setMenuOpen} />,
    'qr-share': <QRShareScreen go={go} config={config} />,
    'theme-customizer': <ThemeCustomizerScreen go={go} config={config} setConfig={setConfig} />,
    'font-picker': <FontPickerScreen go={go} config={config} setConfig={setConfig} />,
    'logo-upload': <LogoUploadScreen go={go} config={config} />,
    'estate-profile': <EstateProfileScreen go={go} config={config} setConfig={setConfig} />,
    'plan-select': <PlanSelectScreen go={go} config={config} setConfig={setConfig} />,
    payment: <PaymentScreen go={go} config={config} setConfig={setConfig} />,
    management: <ManagementScreen go={go} config={config} />,
    'tenant-code': <TenantCodeScreen go={go} config={config} />,
    'tenant-home': <TenantHomeScreen go={go} config={config} menuOpen={menuOpen} setMenuOpen={setMenuOpen} />,
    'tenant-bills': <TenantBillsScreen go={go} config={config} />,
    maintenance: <MaintenanceScreen go={go} config={config} />,
    emergency: <EmergencyScreen go={go} config={config} />,
    guest: <GuestScreen go={go} config={config} />,
    'ai-chatbot': <AIChatbotScreen go={go} config={config} />,
  }

  return (
    <div className="min-h-screen bg-zinc-400 flex items-center justify-center p-0 sm:p-6">
      <div
        className="relative bg-white overflow-hidden w-full sm:w-[400px]"
        style={{
          height: '100dvh',
          maxHeight: '900px',
          fontFamily: "'Plus Jakarta Sans', sans-serif",
          boxShadow: '0 30px 80px rgba(0,0,0,0.4)',
          borderRadius: 'clamp(0px, 2vw, 36px)',
        }}
      >
        {screens[screen]}
      </div>
    </div>
  )
}
